</model>

 <!-- punti di raccolta -->
<model name="place">
  <static>true</static>
  <pose>9 4.25 0.1 0 0 0</pose>
  <link name="link">
    <collision name="base_collision">
      <geometry><box><size>2 1.5 0.1</size></box></geometry>
    </collision>
    <visual name="base_visual">
      <geometry><box><size>2 1.5 0.1</size></box></geometry>
      <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
    </visual>

    <collision name="wall_1_coll">

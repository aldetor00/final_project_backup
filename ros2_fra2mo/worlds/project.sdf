  <!-- cubo -->
<model name="cube">
  <static>true</static>
  <pose>5 3 0.3 0 0 0</pose>

  <link name="link">
    <collision name="collision">
      <geometry>
        <box>
          <size>0.5 0.5 0.5</size>
        </box>
      </geometry>
    </collision>

    <visual name="visual">
      <geometry>
        <box>
          <size>0.5 0.5 0.5</size>
        </box>
      </geometry>
      <material>
        <ambient>1 1 0 1</ambient>
        <diffuse>1 1 0 1</diffuse>
      </material>
    </visual>
  </link>
</model>
 
   <!-- pacchi -->
<model name="package">
  <pose>-5.15 0.04 0.51 0 0 0</pose>
  <static>false</static> 
  
  <link name="package_link">
    <inertial>
      <mass>0.1</mass> <inertia>
        <ixx>0.000027</ixx>
        <iyy>0.000027</iyy>
        <izz>0.0000375</izz>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyz>0</iyz>
      </inertia>
    </inertial>
    
    <collision name="collision">
      <geometry>
        <box>
          <size>0.15 0.15 0.10</size>
        </box>
      </geometry>
      <surface>
        <contact>
          <ode>
            <kp>5000000.0</kp>
            <kd>1000.0</kd>
            <max_vel>0.001</max_vel>
            <min_depth>0.0001</min_depth>
          </ode>
        </contact>
        <friction>
          <ode>
            <mu>3.0</mu>
            <mu2>3.0</mu2>
            <slip1>0.0</slip1>
            <slip2>0.0</slip2>
          </ode>
        </friction>
        <bounce>
          <restitution_coefficient>0.0</restitution_coefficient>
          <threshold>0.0</threshold>
        </bounce>
      </surface>
    </collision>
    
    <visual name="visual">
      <geometry>
        <box>
          <size>0.15 0.15 0.10</size>
        </box>
      </geometry>
      <material>
        <ambient>1 0.5 0 1</ambient>
        <diffuse>1 0.5 0 1</diffuse>
      </material>
    </visual>
    
    <velocity_decay>
      <linear>0.5</linear>
      <angular>0.5</angular>
    </velocity_decay>
  </link>
  
  <include>
    <uri>model://aruco1</uri>
    <pose>0 0 0.05 0 0 1.57</pose> 
  </include>
  
  <joint name="tag_joint_1" type="fixed">
    <parent>package_link</parent>
    <child>aruco1::aruco_link</child> 
  </joint>
</model>
<model name="package2">
  <pose>-5.15 0.45 0.51 0 0 0</pose>
  <static>false</static>
  
  <link name="package2_link">
    <inertial>
